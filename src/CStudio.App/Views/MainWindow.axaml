<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CStudio.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:CStudio.Core.Models"
        mc:Ignorable="d"
        x:Class="CStudio.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1500"
        Height="825"
        MinWidth="1180"
        MinHeight="760"
        Background="#131722"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        FontFamily="Segoe UI, Inter, Arial">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Alt+Left" Command="{Binding PreviousWorkspaceCommand}" />
    <KeyBinding Gesture="Ctrl+Alt+Right" Command="{Binding NextWorkspaceCommand}" />
    <KeyBinding Gesture="Meta+Alt+Left" Command="{Binding PreviousWorkspaceCommand}" />
    <KeyBinding Gesture="Meta+Alt+Right" Command="{Binding NextWorkspaceCommand}" />
  </Window.KeyBindings>

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Window.Styles>
    <Style Selector="Border.chrome">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="#2E3648" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#AAB4C8" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="Border.tab-active">
      <Setter Property="Background" Value="#212B3B" />
      <Setter Property="BorderBrush" Value="#4A638A" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="30,*,25" Background="#131722">
    <Border Grid.Row="0" Background="#171D2A" BorderBrush="#252D3E" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="8,0,10,0">
        <TextBlock VerticalAlignment="Center" Text="cstudio" FontWeight="Bold" Foreground="#F5F7FA" />
        <ItemsControl Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding Menus}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:ShellMenuItem">
              <TextBlock Text="{Binding Header}" Foreground="#D6DDEA" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Grid.Column="2"
                Margin="18,4,0,4"
                Padding="8,0"
                Background="#141B27"
                BorderBrush="#2E3648"
                BorderThickness="1"
                CornerRadius="8">
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <Button Command="{Binding PreviousWorkspaceCommand}"
                    IsEnabled="{Binding CanSwitchWorkspaces}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    MinWidth="18">
              <TextBlock Text="&lt;" Foreground="#C8D0DD" VerticalAlignment="Center" />
            </Button>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="{Binding ActiveWorkspace.Title}"
                       Foreground="{Binding ActiveWorkspace.Accent}"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Text="{Binding WorkspacePosition}"
                       Foreground="#7E8CA4"
                       FontSize="11" />
            <Button Grid.Column="3"
                    Command="{Binding NextWorkspaceCommand}"
                    IsEnabled="{Binding CanSwitchWorkspaces}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    MinWidth="18">
              <TextBlock Text="&gt;" Foreground="#C8D0DD" VerticalAlignment="Center" />
            </Button>
            <TextBlock Grid.Column="4"
                       VerticalAlignment="Center"
                       Text="{Binding ActiveWorkspace.ShortTitle}"
                       Foreground="#6E7A90"
                       FontSize="11" />
          </Grid>
        </Border>
        <TextBlock Grid.Column="3"
                   Margin="24,0,0,0"
                   VerticalAlignment="Center"
                   Foreground="#8D98AE"
                   Text="{Binding SelectedWorkspaceLabel}" />
        <ItemsControl Grid.Column="4" VerticalAlignment="Center" ItemsSource="{Binding ActionBadges}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:ShellBadge">
              <Border Classes="badge chrome" Background="#20283A">
                <TextBlock Text="{Binding Text}" Foreground="{Binding Accent}" FontSize="12" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="52,280,6,*,6,320" Margin="0">
      <Border Grid.Column="0" Background="#111722" BorderBrush="#252D3E" BorderThickness="0,0,1,0">
        <StackPanel Margin="0,14,0,0" Spacing="10" HorizontalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="8" Background="#263146">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="W" Foreground="#EAF0F8" FontWeight="Bold" />
          </Border>
          <Border Width="34" Height="34" CornerRadius="8" Background="#1B2331">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="D" Foreground="#90A4C4" FontWeight="Bold" />
          </Border>
          <Border Width="34" Height="34" CornerRadius="8" Background="#1B2331">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="P" Foreground="#90A4C4" FontWeight="Bold" />
          </Border>
          <Border Width="34" Height="34" CornerRadius="8" Background="#1B2331">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="R" Foreground="#90A4C4" FontWeight="Bold" />
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Classes="chrome" Background="#181E2A" Padding="14" Margin="10,10,0,10">
        <StackPanel Spacing="12">
          <TextBlock Classes="section-title" Text="Workspace" />
          <ItemsControl ItemsSource="{Binding Workspace}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:WorkspaceNode">
                <Border Background="#1E2533" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F1F4F8" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="#141A25" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                            <TextBlock Text="{Binding}" Foreground="#B8C1D4" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <GridSplitter Grid.Column="2" ResizeDirection="Columns" Background="#293142" />

      <Border Grid.Column="3" Classes="chrome" Background="#121722" Padding="0" Margin="10,10,0,10">
        <Grid RowDefinitions="36,Auto,*,190" RowSpacing="0">
          <Border Background="#161C28" BorderBrush="#252D3E" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock VerticalAlignment="Center" Text="Dock Host" Foreground="#F5F7FA" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Right"
                         Foreground="#6E7A90"
                         Text="{Binding WorkspaceSummary}" />
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding Documents}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:DocumentTab">
                <Button x:CompileBindings="False"
                        Command="{Binding DataContext.ActivateDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0">
                  <Border Background="#1A2230" CornerRadius="8,8,0,0" Padding="12,10" MinWidth="180">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Title}" Foreground="#F2F5F8" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Subtitle}" Foreground="#8390A6" FontSize="12" />
                    </StackPanel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Grid.Row="2" Background="#171D29" BorderBrush="#252D3E" BorderThickness="0,1,0,1" Padding="18">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding SelectedDocument.Title}" FontSize="22" FontWeight="Bold" Foreground="#F6F8FB" />
                <TextBlock Text="{Binding Subtitle}" Foreground="#7E8CA4" />
                <TextBlock Text="{Binding ActiveWorkspace.Summary}" Foreground="#627089" FontSize="12" />
              </StackPanel>
              <ContentControl Grid.Row="1"
                              Content="{Binding SelectedDocumentView}"
                              IsVisible="{Binding !ShowSelectedDocumentText}" />
              <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowSelectedDocumentText}">
                <TextBlock Text="{Binding SelectedDocument.Content}" Foreground="#C5CDDB" FontFamily="Cascadia Code, JetBrains Mono, Consolas" TextWrapping="Wrap" />
              </ScrollViewer>
            </Grid>
          </Border>

          <Border Grid.Row="3" Background="#141925" Padding="14">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Classes="section-title" Text="Log" />
              <ItemsControl Grid.Row="1" ItemsSource="{Binding Logs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:LogEntry">
                    <Grid ColumnDefinitions="72,80,*" Margin="0,0,0,8">
                      <TextBlock Text="{Binding Timestamp}" Foreground="#7F8AA0" />
                      <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="#D6C37F" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#C8D0DD" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="4" ResizeDirection="Columns" Background="#293142" />

      <Border Grid.Column="5" Classes="chrome" Background="#181D28" Padding="14" Margin="10,10,10,10">
        <StackPanel Spacing="12">
          <TextBlock Classes="section-title" Text="Properties" />
          <Border Background="#111722" CornerRadius="6" Padding="12">
            <StackPanel Spacing="4">
              <TextBlock Text="Selection Snapshot" Foreground="#EAF0F8" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedDocument.Title}" Foreground="#97A4BB" FontSize="12" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Properties}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PropertyEntry">
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                  <TextBlock Text="{Binding Name}" Foreground="#8E9BB0" Margin="0,0,10,0" />
                  <Border Grid.Column="1" Background="#111722" CornerRadius="5" Padding="8,6">
                    <TextBlock Text="{Binding Value}" Foreground="#EEF2F8" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#0F141D" BorderBrush="#232B3C" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0">
        <TextBlock VerticalAlignment="Center"
                   Text="{Binding StatusText}"
                   Foreground="#738198"
                   FontSize="11" />
        <ItemsControl Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0" ItemsSource="{Binding LeftStatus}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Foreground="#96A3BA" FontSize="12" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14">
          <TextBlock VerticalAlignment="Center"
                     Text="{Binding ActiveWorkspace.Title}"
                     Foreground="{Binding ActiveWorkspace.Accent}"
                     FontSize="12"
                     FontWeight="SemiBold" />
          <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding RightStatus}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:ShellBadge">
                <TextBlock Text="{Binding Text}" Foreground="{Binding Accent}" FontSize="12" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
