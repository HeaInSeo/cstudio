<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CStudio.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:CStudio.Core.Models"
        mc:Ignorable="d"
        x:Class="CStudio.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1480"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        Background="#131722"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Window.Styles>
    <Style Selector="Border.chrome">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="#2E3648" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#AAB4C8" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="72,48,*,170,30" Background="#131722">
    <Border Grid.Row="0" Background="#171D2A" BorderBrush="#2A3142" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="22,14">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding WindowTitle}" FontSize="28" FontWeight="Bold" Foreground="#F5F7FA" />
          <TextBlock Text="{Binding Subtitle}" Foreground="#8D98AE" FontSize="13" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="chrome" Background="#20283A" Padding="12,8">
            <TextBlock Text="Workspace" Foreground="#D5DDEA" />
          </Border>
          <Border Classes="chrome" Background="#273348" Padding="12,8">
            <TextBlock Text="Documents" Foreground="#D5DDEA" />
          </Border>
          <Border Classes="chrome" Background="#5C4A1A" BorderBrush="#806A26" Padding="12,8">
            <TextBlock Text="Mock Runtime" Foreground="#F3D98B" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#151A26" BorderBrush="#252D3E" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="18" Margin="22,0" VerticalAlignment="Center">
        <TextBlock Text="File" Foreground="#D6DDEA" />
        <TextBlock Text="Workspace" Foreground="#D6DDEA" />
        <TextBlock Text="Window" Foreground="#D6DDEA" />
        <TextBlock Text="Tools" Foreground="#D6DDEA" />
        <TextBlock Text="Help" Foreground="#D6DDEA" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="290,6,*,6,320" Margin="16,16,16,12">
      <Border Grid.Column="0" Classes="chrome" Background="#181E2A" Padding="14">
        <StackPanel Spacing="12">
          <TextBlock Classes="section-title" Text="Workspace" />
          <ItemsControl ItemsSource="{Binding Workspace}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:WorkspaceNode">
                <Border Background="#1E2533" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F1F4F8" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="#141A25" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                            <TextBlock Text="{Binding}" Foreground="#B8C1D4" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#293142" />

      <Border Grid.Column="2" Classes="chrome" Background="#121722" Padding="14">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <ItemsControl ItemsSource="{Binding Documents}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:DocumentTab">
                <Border Background="#1A2230" CornerRadius="8,8,0,0" Padding="12,10" MinWidth="180">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" Foreground="#F2F5F8" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="#8390A6" FontSize="12" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Grid.Row="1" Background="#171D29" CornerRadius="0,8,8,8" Padding="18">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Text="{Binding SelectedDocument.Title}" FontSize="22" FontWeight="Bold" Foreground="#F6F8FB" />
              <ScrollViewer Grid.Row="1">
                <TextBlock Text="{Binding SelectedDocument.Content}" Foreground="#C5CDDB" FontFamily="Cascadia Code, JetBrains Mono, Consolas" TextWrapping="Wrap" />
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="#293142" />

      <Border Grid.Column="4" Classes="chrome" Background="#181D28" Padding="14">
        <StackPanel Spacing="12">
          <TextBlock Classes="section-title" Text="Properties" />
          <ItemsControl ItemsSource="{Binding Properties}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PropertyEntry">
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                  <TextBlock Text="{Binding Name}" Foreground="#8E9BB0" Margin="0,0,10,0" />
                  <Border Grid.Column="1" Background="#111722" CornerRadius="5" Padding="8,6">
                    <TextBlock Text="{Binding Value}" Foreground="#EEF2F8" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="3" Margin="16,0,16,12" Classes="chrome" Background="#141925" Padding="14">
      <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <TextBlock Classes="section-title" Text="Log" />
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Logs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:LogEntry">
              <Grid ColumnDefinitions="72,80,*" Margin="0,0,0,8">
                <TextBlock Text="{Binding Timestamp}" Foreground="#7F8AA0" />
                <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="#D6C37F" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#C8D0DD" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <Border Grid.Row="4" Background="#0F141D" BorderBrush="#232B3C" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="16,0">
        <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" Foreground="#96A3BA" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Reference: GPU-Reshape Studio" Foreground="#6E7A90" />
      </Grid>
    </Border>
  </Grid>
</Window>
